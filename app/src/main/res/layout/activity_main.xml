<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4EFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="28dp">

        <TextView
            android:id="@+id/stickerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🤖✨"
            android:textSize="40sp" />

        <TextView
            android:id="@+id/titleText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Tanno"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="#4B2FA3" />

        <TextView
            android:id="@+id/creditText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="by Hanena Ubadi (Ubaidullah)"
            android:textSize="12sp"
            android:textColor="#8873C9" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="😴 Tayyar nahi (model load ho raha hai)" />

        <Button
            android:id="@+id/enableAccessibilityBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="🛠️ Accessibility Service On Karein" />

        <Button
            android:id="@+id/enableNotificationBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🔔 Notification Access On Karein" />

        <Button
            android:id="@+id/startListeningBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🎙️ Sunna Shuru Karein" />

        <Button
            android:id="@+id/enableOverlayBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="👻 Floating Tanno Har Screen Par Dikhayein" />

    </LinearLayout>
</ScrollView>
